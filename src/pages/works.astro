---
import BaseLayout from '../layouts/BaseLayout.astro';
import { works } from '../data/works';
---

<BaseLayout title="作品展示 · 你的游戏名攻略站" description="游戏相关作品：剪辑、MOD、关卡设计等">
  <h1 class="section-title">作品展示（{works.length} 件）</h1>

  <div class="works-grid">
    {
      works.map((work) => (
        <article class="work-card">
          <div class="work-thumb" style={`background:${work.gradient ?? 'var(--color-primary-light)'}`}>
            {work.image ? (
              <img src={work.image} alt={work.title} loading="lazy" width="400" height="150" />
            ) : (
              work.title
            )}
          </div>
          <h3 class="work-title">{work.title}</h3>
          <p class="work-desc">{work.description}</p>
          <div style="margin: 0 1rem 0.5rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
            {work.tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </div>
          {work.link && (
            <a href={work.link} target="_blank" rel="noopener" class="work-link">
              查看详情 →
            </a>
          )}
        </article>
      ))
    }
  </div>
</BaseLayout>
