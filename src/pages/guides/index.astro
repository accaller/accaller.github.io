---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils';

const gradients = [
  'linear-gradient(135deg, #667eea, #764ba2)',
  'linear-gradient(135deg, #f093fb, #f5576c)',
  'linear-gradient(135deg, #4facfe, #00f2fe)',
  'linear-gradient(135deg, #43e97b, #38f9d7)',
];

// 全部攻略：置顶优先，其余按日期倒序
const guides = (await getCollection('guides')).sort((a, b) => {
  if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});

// 按游戏名分组（保持最近更新的游戏排前面）
const byGame = new Map<string, typeof guides>();
for (const g of guides) {
  const list = byGame.get(g.data.game) ?? [];
  list.push(g);
  byGame.set(g.data.game, list);
}
---

<BaseLayout title="全部攻略 · 你的游戏名攻略站" description="按游戏分类的全部攻略文章">
  <h1 class="section-title">全部攻略（{guides.length} 篇）</h1>

  {
    guides.length === 0 ? (
      <div class="empty-tip">
        还没有攻略。在 <code>src/content/guides/</code> 里新建 .md 文件即可发布第一篇！
      </div>
    ) : (
      [...byGame.entries()].map(([game, list]) => (
        <section style="margin-bottom: 2.5rem;">
          <h2 class="section-title" style="font-size: 1.2rem; display: flex; align-items: center; gap: 0.6rem;">
            <span class="tag">{game}</span>
            <span style="color: var(--color-text-light); font-size: 0.85rem; font-weight: 400;">
              {list.length} 篇
            </span>
          </h2>
          <div class="guides-grid">
            {list.map((guide, i) => (
              <a href={withBase(`/guides/${guide.id}/`)} class="guide-card">
                <div
                  class="guide-card-cover"
                  style={`background:${guide.data.cover ? 'var(--color-alt-bg)' : gradients[i % gradients.length]}`}
                >
                  {guide.data.cover ? (
                    <img src={guide.data.cover} alt={guide.data.title} loading="lazy" width="400" height="140" />
                  ) : (
                    <span>{guide.data.game}</span>
                  )}
                </div>
                <div class="guide-card-body">
                  <div class="guide-card-meta">
                    <time datetime={guide.data.date.toISOString()}>
                      {guide.data.date.toLocaleDateString('zh-CN')}
                    </time>
                    {guide.data.pinned && <span class="tag">置顶</span>}
                  </div>
                  <h3 class="guide-card-title">{guide.data.title}</h3>
                  <p class="guide-card-desc">{guide.data.description}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))
    )
  }
</BaseLayout>
