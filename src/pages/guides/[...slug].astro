---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
---

<BaseLayout title={`${guide.data.title} · acc攻略站`} description={guide.data.description}>
  <article>
    <header class="post-header">
      <h1>{guide.data.title}</h1>
      <div class="post-meta">
        <span class="tag">{guide.data.category}</span>
        {guide.data.subcategory && <span class="tag tag--accent">{guide.data.subcategory}</span>}
        <time datetime={guide.data.date.toISOString()}>
          发布于 {guide.data.date.toLocaleDateString('zh-CN')}
        </time>
        {guide.data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>

    {guide.data.cover && <img src={guide.data.cover} alt={guide.data.title} width="860" height="400" loading="lazy" decoding="async" />}

    <div class="prose">
      <Content />
    </div>
  </article>

  <p style="margin-top: 3rem;">
    <a href={withBase('/guides/')}>← 返回攻略列表</a>
  </p>
</BaseLayout>
