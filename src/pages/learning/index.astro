---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { learning } from '../../data/learning';
import { withBase } from '../../utils';

const langPalette: Record<string, string> = {
  Python: 'linear-gradient(135deg, #E6F1FB, #B5D4F4)',
  JavaScript: 'linear-gradient(135deg, #FAEEDA, #FAC775)',
  HTML: 'linear-gradient(135deg, #EEEDFE, #AFA9EC)',
};

function coverStyle(item) {
  return item.gradient ?? langPalette[item.lang] ?? 'var(--color-primary-light)';
}
---

<BaseLayout
  title="学习区 · python 程序开发"
  description="acc 用课余时间自己写的 python 小工具与小程序，欢迎下载试用。"
>
  <!-- 顶部 banner：用真实封面图 -->
  <div style="width:100%;height:260px;overflow:hidden;border-radius:14px;margin-bottom:1.5rem;">
    <img
      src={withBase('/images/learning/cover.jpg')}
      alt="学习区封面"
      width="1200"
      height="260"
      loading="eager"
      style="width:100%;height:100%;object-fit:cover;display:block;"
    />
  </div>

  <h1 class="section-title" style="margin-top:0;">学习区 · python 程序开发</h1>
  <p style="color:var(--color-text-light);margin-top:-0.4rem;">
    自己动手做的小程序：抓数据、写小工具，持续更新中。
  </p>

  {
    learning.length === 0 ? (
      <div class="empty-tip">
        还没有小程序。在 <code>src/data/learning.ts</code> 里加一条数据即可发布！
      </div>
    ) : (
      <div class="works-grid">
        {learning.map((item) => (
          <article class="work-card">
            <a href={withBase(`/learning/${item.slug}/`)} style="text-decoration:none;color:inherit;">
              <div class="work-thumb" style={`background:${coverStyle(item)}`}>
                {item.image ? (
                  <img src={item.image} alt={item.title} loading="lazy" width="400" height="150" />
                ) : (
                  <span style="font-size:0.95rem;color:#fff;font-weight:500;">
                    {item.lang}
                  </span>
                )}
              </div>
              <h3 class="work-title">
                {item.title} <span class="tag">{item.version}</span>
              </h3>
              <p class="work-desc">{item.description}</p>
            </a>
            <div style="margin:0 1rem 0.5rem;display:flex;gap:0.5rem;flex-wrap:wrap;">
              {item.stack.map((t) => <span class="tag">{t}</span>)}
            </div>
            <div style="margin:0.2rem 1rem 1rem;display:flex;align-items:center;justify-content:space-between;gap:0.75rem;">
              <span style="font-size:0.75rem;color:var(--color-text-light);">
                {item.platform}{item.downloads?.[0]?.size ? ` · ${item.downloads[0].size}` : ''}
              </span>
              <a
                href={withBase('/learning/' + item.slug + '/')}
                class="btn-primary"
                style="font-size:0.8rem;padding:0.35rem 0.9rem;"
              >
                查看详情 →
              </a>
            </div>
          </article>
        ))}
      </div>
    )
  }
</BaseLayout>
