---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils';
import { learning } from '../data/learning';
import { works } from '../data/works';
import { getCollection } from 'astro:content';

const guidesCount = (await getCollection('guides')).length;
const appsCount = learning.length;
const worksCount = works.length;

// 板块卡片样式（覆盖 global.css 中默认的白字，在白底卡片上看不清）
const cardTitleStyle = 'margin-top:0;color:#1a1a2e;font-size:1.6rem;font-weight:700;';
const cardDescStyle = 'color:#4a5568;font-size:0.95rem;';
const cardLinkStyle = 'color:#2563eb;font-weight:600;font-size:0.95rem;margin-top:0.5rem;';

// 让两卡片等高：grid stretch + 内部 flex 填满
const cardStyle = 'display:flex;flex-direction:column;height:100%;';
const cardLinkWrapStyle = 'display:flex;flex-direction:column;flex:1;text-decoration:none;color:inherit;';
const cardBodyStyle = 'padding:1.25rem 1.25rem 1rem;flex:1;display:flex;flex-direction:column;justify-content:space-between;';
---

<BaseLayout
  title="acc攻略站 · 游戏攻略与小程序"
  description="acc 的个人站：游戏攻略（缺氧/CS）+ 自己写的小程序下载"
>
  <!-- Hero -->
  <section class="hero">
    <h1>欢迎来到<span class="highlight">acc攻略站</span></h1>
    <p>游戏攻略 · 学习小程序 · 持续更新中</p>
  </section>

  <!-- 选择区：两大板块水平并排入口 -->
  <h2 class="section-title" style="margin-top:2rem;">选择区</h2>
  <div class="category-grid" style="grid-template-columns:repeat(2, minmax(0, 1fr));gap:1.5rem;align-items:stretch;">

    <!-- 学习区板块 -->
    <article class="category-card" style={cardStyle}>
      <a href={withBase('/learning/')} style={cardLinkWrapStyle}>
        <div class="category-card-header" style="padding:0;height:200px;overflow:hidden;flex-shrink:0;">
          <img
            src={withBase('/images/learning/cover.jpg')}
            alt="学习区封面"
            loading="lazy"
            width="600"
            height="200"
            style="width:100%;height:100%;object-fit:cover;display:block;"
          />
        </div>
        <div class="category-card-body" style={cardBodyStyle}>
          <div>
            <h3 class="category-name" style={cardTitleStyle}>学习区</h3>
            <p class="category-desc" style={cardDescStyle}>各种程序/脚本/工具开发</p>
            <div class="subcategory-list">
              <div class="subcategory-item" style="cursor:default;">
                <span class="subcategory-name">小程序</span>
                <span class="subcategory-count">{appsCount} 件</span>
              </div>
            </div>
          </div>
          <p class="category-link" style={cardLinkStyle}>进入学习区 →</p>
        </div>
      </a>
    </article>

    <!-- game 区板块 -->
    <article class="category-card" style={cardStyle}>
      <a href={withBase('/game/')} style={cardLinkWrapStyle}>
        <div class="category-card-header" style="padding:0;height:200px;overflow:hidden;flex-shrink:0;">
          <img
            src={withBase('/images/game/cover.png')}
            alt="game 区封面"
            loading="lazy"
            width="600"
            height="200"
            style="width:100%;height:100%;object-fit:cover;display:block;"
          />
        </div>
        <div class="category-card-body" style={cardBodyStyle}>
          <div>
            <h3 class="category-name" style={cardTitleStyle}>game</h3>
            <p class="category-desc" style={cardDescStyle}>缺氧 / CS 攻略 · 游戏相关作品</p>
            <div class="subcategory-list">
              <div class="subcategory-item" style="cursor:default;">
                <span class="subcategory-name">攻略</span>
                <span class="subcategory-count">{guidesCount} 篇</span>
              </div>
              <div class="subcategory-item" style="cursor:default;">
                <span class="subcategory-name">作品</span>
                <span class="subcategory-count">{worksCount} 件</span>
              </div>
            </div>
          </div>
          <p class="category-link" style={cardLinkStyle}>进入 game 区 →</p>
        </div>
      </a>
    </article>

  </div>

  <!-- 关于 -->
  <section id="about" style="margin-top: 4rem;">
    <h2 class="section-title">关于我</h2>
    <blockquote class="prose" style="border-left: 4px solid var(--color-primary); padding: 1rem 1.2rem; background: var(--color-surface-light); border-radius: 0 12px 12px 0;">
      <p>
        暂无。
      </p>
    </blockquote>
  </section>
</BaseLayout>
