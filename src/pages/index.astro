---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils';
import { works } from '../data/works';

const guides = (await getCollection('guides')).sort((a, b) => {
  if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});

type SubCategory = { name: string; count: number };
type Category = {
  name: '缺氧' | 'CS';
  desc: string;
  gradient: string;
  image: string;
  subcategories: SubCategory[];
};

const countGuides = (cat: string, sub?: string) =>
  guides.filter((g) => g.data.category === cat && (sub ? g.data.subcategory === sub : !g.data.subcategory || true)).length;

const categories: Category[] = [
  {
    name: '缺氧',
    desc: '基地生存、资源管理、间歇泉利用',
    gradient: 'linear-gradient(135deg, #f093fb, #f5576c)',
    image: '/images/category-oxygen.jpg',
    subcategories: [
      { name: '气泉', count: countGuides('缺氧', '气泉') },
      { name: '水泉', count: countGuides('缺氧', '水泉') },
    ],
  },
  {
    name: 'CS',
    desc: '投掷物点位、地图站位与战术',
    gradient: 'linear-gradient(135deg, #4facfe, #00f2fe)',
    image: '/images/category-cs.jpg',
    subcategories: [
      { name: '道具', count: countGuides('CS', '道具') },
      { name: '站位', count: countGuides('CS', '站位') },
    ],
  },
];
---

<BaseLayout title="acc攻略站 · 缺氧与 CS 攻略及作品展示">
  <!-- Hero -->
  <section class="hero">
    <h1>欢迎来到<span class="highlight">acc攻略站</span></h1>
    <p>缺氧 · CS · 更多游戏持续更新中</p>
    <a href={withBase('/guides/')} class="btn-primary">浏览全部攻略 →</a>
  </section>

  <!-- 两大攻略板块入口 -->
  <section>
    <h2 class="section-title">攻略板块</h2>
    <div class="category-grid">
      {
        categories.map((cat) => (
          <article class="category-card">
            <div class="category-card-header" style={`background:${cat.gradient}`}>
              <img src={cat.image} alt={`${cat.name} 分类插画`} loading="lazy" width="96" height="96" />
              <div>
                <h3 class="category-name">{cat.name}</h3>
                <p class="category-desc">{cat.desc}</p>
              </div>
            </div>
            <div class="category-card-body">
              <div class="subcategory-list">
                {
                  cat.subcategories.map((sub) => (
                    <a
                      href={withBase(`/guides/#${cat.name}-${sub.name}`)}
                      class="subcategory-item"
                    >
                      <span class="subcategory-name">{sub.name}</span>
                      <span class="subcategory-count">{sub.count} 篇</span>
                    </a>
                  ))
                }
              </div>
              <a href={withBase(`/guides/#${cat.name}`)} class="category-link">
                查看全部「{cat.name}」攻略 →
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 作品展示 -->
  <section style="margin-top: 4rem;">
    <h2 class="section-title">作品展示</h2>
    <div class="works-grid">
      {
        works.slice(0, 3).map((work) => (
          <article class="work-card">
            <div class="work-thumb" style={`background:${work.gradient ?? 'var(--color-primary-light)'}`}>
              {work.image ? <img src={work.image} alt={work.title} loading="lazy" width="400" height="150" /> : work.title}
            </div>
            <h3 class="work-title">{work.title}</h3>
            <p class="work-desc">{work.description}</p>
            {work.link && (
              <a href={work.link} target="_blank" rel="noopener" class="work-link">
                查看详情 →
              </a>
            )}
          </article>
        ))
      }
    </div>
    <p style="text-align:center; margin-top: 1.5rem;">
      <a href={withBase('/works/')}>查看全部作品 →</a>
    </p>
  </section>

  <!-- 关于 -->
  <section id="about" style="margin-top: 4rem;">
    <h2 class="section-title">关于我</h2>
    <blockquote class="prose" style="border-left: 4px solid var(--color-primary); padding: 1rem 1.2rem; background: var(--color-surface-light); border-radius: 0 12px 12px 0;">
      <p>
        把这段话换成你的自我介绍：玩什么游戏、擅长什么（速通/攻略/剪辑/MOD）、
        这个站用来做什么。两三句话就够，重要的是让人记住你。
      </p>
    </blockquote>
  </section>
</BaseLayout>
